{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBranch",
  "version": "1.3.0",
  "identifier": "ai.rosepetal.gitbranch",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitBranch",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Rosepetal",
    "copyright": "Copyright (c) 2026 AIS Vision Systems",
    "license": "PolyForm Noncommercial 1.0.0 or commercial license (see LICENSE.md)",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight Git client with a commit graph",
    "longDescription": "GitBranch is a lightweight Git desktop client: commit graph first, worktrees and GitHub pull requests. It drives the system git; git must be installed.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "GitBranch"
      }
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "section": "devel"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQUY1NjY2QTQ4RjczMEQKUldRTmM0K2tabGF2NFZlLzdHNEcwa0RhNmdVcVUzZjY2WkZNUmh4WnQraElrbmhmRkdKS3U4M0gK",
      "endpoints": [
        "https://github.com/AIS-Vision-Systems/GitBranch/releases/latest/download/latest.json"
      ]
    }
  }
}
